    "id": "router",
    "type": "function",
    "name": "Router (bin/type)",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const p = msg.topic.split('/');\nif (p.length < 4) return null;\nflow.set('lastSeen_' + p[2], Date.now());\nconst base = { bin: p[2], type: p[3], payload: String(msg.payload) };\nconst o = [null, null, null, null, null, { ...base, topic: p[2] }];\nif (p[3] === 'khoangcach') o[0] = base;\nelse if (p[3] === 'battery') o[1] = base;\nelse if (p[3] === 'canhbao') o[2] = base;\nelse if (p[3] === 'gps') o[3] = base;\nelse if (p[3] === 'config') o[4] = base;\nreturn o;"
  },
  {
    "z": "tab1",
    "x": 640,
    "y": 40,
    "wires": [
