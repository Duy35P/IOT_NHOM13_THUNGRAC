    "id": "log_fmt",
    "type": "function",
    "name": "Dinh dang dong CSV",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const file = flow.get('logfile');\nif (!file) return null;\nconst t = new Date().toLocaleString('vi-VN', { hour12: false });\nconst v = String(msg.payload).replace(/\"/g, '\"\"');\nreturn { filename: file, payload: t + ',\"' + (msg.bin || 'he_thong') + '\",\"' + (msg.level || 'INFO') + '\",\"' + v + '\"\\n' };"
  },
