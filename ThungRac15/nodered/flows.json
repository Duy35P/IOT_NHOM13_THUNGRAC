    "id": "alert_fn",
    "type": "function",
    "name": "Canh bao + dem lan mo nap",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const o = [{ bin: msg.bin, level: 'CANH_BAO', payload: msg.payload }, null, null];\nif (msg.payload.includes('mở nắp')) {\n  const day = new Date().toLocaleDateString('vi-VN');\n  let c = flow.get('opens') || { day, n: 0 };\n  if (c.day !== day) c = { day, n: 0 };\n  c.n++;\n  flow.set('opens', c);\n  o[1] = { payload: c.n };\n}\nif (msg.payload.includes('KHẨN CẤP')) o[2] = { payload: msg.payload };\nreturn o;"
  },
