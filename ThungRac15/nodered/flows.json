    "id": "rule2",
    "type": "function",
    "name": "RULE 2: ECO 22h-05h (scheduler)",
    "outputs": 3,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "if (msg.topic === 'eco') flow.set('forceEco', msg.payload === true);\nconst h = new Date().getHours();\nconst eco = flow.get('forceEco') || h >= 22 || h < 5;\nconst mode = eco ? 'ECO' : 'NORMAL';\nif (flow.get('mode') === mode) return null; // chi gui khi doi trang thai\nflow.set('mode', mode);\nreturn [\n  { topic: 'doan/nhom15/bin1/mode', payload: mode },\n  { bin: 'bin1', level: 'RULE2_' + mode, payload: eco ? 'Vao che do ECO: gian chu ky do 3s -> 30s' : 'Ve che do NORMAL: chu ky do 3s' },\n  { payload: mode }\n];"
  },
