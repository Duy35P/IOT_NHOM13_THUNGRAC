    "id": "rule1",
    "type": "function",
    "name": "RULE 1: Chong tran -> khoa nap",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const bin = msg.bin;\nconst d = parseFloat(msg.payload);\nif (isNaN(d)) return null;\nconst thr = flow.get('thr_' + bin) || 5;\nconst locked = flow.get('lock_' + bin) || false;\nconst pct = Math.max(0, Math.min(100, Math.round((40 - d) / (40 - thr) * 100)));\nconst o = [{ payload: pct, topic: bin }, { payload: d, topic: bin }, null, null];\nconst lockTopic = 'doan/nhom15/' + bin + '/lock';\nif (d <= thr && !locked) {\n  flow.set('lock_' + bin, true);\n  o[2] = { topic: lockTopic, payload: '1' };\n  o[3] = { bin, level: 'RULE1_KHOA_NAP', payload: 'Thung day (' + d + 'cm <= ' + thr + 'cm) -> khoa nap chong tran' };\n} else if (d > thr + 3 && locked) { // histeresis 3cm tranh khoa/mo lien tuc\n  flow.set('lock_' + bin, false);\n  o[2] = { topic: lockTopic, payload: '0' };\n  o[3] = { bin, level: 'RULE1_MO_KHOA', payload: 'Da do rac (' + d + 'cm) -> mo khoa nap' };\n}\nreturn o;"
  },
