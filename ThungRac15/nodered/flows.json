    "id": "wd_fn",
    "type": "function",
    "name": "ABNORMAL: mat tin hieu",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const bin = msg.topic;\nconst mode = flow.get('mode') || 'NORMAL';\nconst lastSeen = flow.get('lastSeen_' + bin) || 0;\nconst now = Date.now();\nif (mode === 'ECO' && (now - lastSeen) < 60000) return null;\nconst timeoutTxt = (mode === 'ECO') ? '> 60s' : '> 20s';\nconst txt = 'MAT TIN HIEU ' + String(bin).toUpperCase() + ' ' + timeoutTxt + ' (offline / het pin / mat Wi-Fi)';\nreturn [{ bin: bin, level: 'LOI_MAT_TIN_HIEU', payload: txt }, { payload: txt }];"
  },
