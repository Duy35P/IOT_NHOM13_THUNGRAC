    "id": "gps_fn",
    "type": "function",
    "name": "GPS -> link Maps + log",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const m = msg.payload.match(/Lat:\\s*([0-9.]+),\\s*Lng:\\s*([0-9.]+)/);\nconst link = m ? 'https://www.google.com/maps/search/?api=1&query=' + m[1] + ',' + m[2] : msg.payload;\nreturn [{ payload: '<a href=\"' + link + '\" target=\"_blank\">' + msg.payload + '</a>' }, { bin: msg.bin, level: 'GPS', payload: msg.payload }];"
